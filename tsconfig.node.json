{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // DOM: an e2e spec's `page.evaluate` callback is typed here but runs in the browser
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    // `preserve`/`bundler`, not `nodenext`: this project also typechecks the e2e specs, and their
    // fixtures import the engine (`src/core/wall.ts`) so a board is dealt the way the engine deals
    // it. Under nodenext resolution that pulls the whole extensionless `src` tree into a project
    // that demands file extensions; Playwright and Vite both resolve these imports the bundler way
    // anyway, which is how `tsconfig.app.json` already reads the same files.
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
